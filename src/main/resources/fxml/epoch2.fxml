<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<Pane prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.Epoch2Controller">
   <children>
      <AnchorPane fx:id="epoch2MainPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="800.0">
         <children>
            <ImageView fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/Epoch%202%20Images/epoch2DanSmoking.jpg" />
               </image></ImageView>
            <Rectangle fx:id="rectAlex" arcHeight="5.0" arcWidth="5.0" fill="#d07a71" height="317.0" layoutX="380.0" layoutY="90.0" onMouseClicked="#onAlexClick" onMouseEntered="#onHover" onMouseExited="#onExit" opacity="0.0" stroke="BLACK" strokeType="INSIDE" width="154.0" />
            <Label fx:id="lblTimer" alignment="CENTER" contentDisplay="CENTER" layoutX="371.0" layoutY="18.0" prefHeight="33.0" prefWidth="75.0" styleClass="timer-label" textAlignment="CENTER" />
            <Rectangle fx:id="rectPanel" arcHeight="5.0" arcWidth="5.0" fill="#d07a71" height="33.0" layoutX="364.0" layoutY="153.0" onMouseClicked="#onClickPanelRectangle" onMouseEntered="#onHover" onMouseExited="#onExit" opacity="0.0" stroke="BLACK" strokeType="INSIDE" width="24.0" />
            <Circle fx:id="travelCircle" fill="#d07a71" layoutX="80.0" layoutY="45.0" onMouseClicked="#onTravelClick" onMouseEntered="#onHover" onMouseExited="#onExit" opacity="0.0" radius="33.0" stroke="BLACK" strokeType="INSIDE" />
            <Button fx:id="muteBtn" layoutX="697.0" layoutY="386.0" mnemonicParsing="false" onAction="#onMute" styleClass="mute-button" text="Text" />
            <Button fx:id="decisionButton" layoutX="16.0" layoutY="90.0" mnemonicParsing="false" onMouseClicked="#onDecisionButtonClick" styleClass="decision-button" text="Make your decision" />
            <Label fx:id="incompleteInvestigationLbl" layoutX="24.0" layoutY="119.0" prefHeight="134.0" prefWidth="113.0" style="-fx-background-color: black;" textAlignment="CENTER" textFill="WHITE" wrapText="true" />
         </children>
      </AnchorPane>
      <AnchorPane fx:id="chatPanelAnchorPane" prefHeight="400.0" prefWidth="800.0" visible="false">
         <children>
            <fx:include fx:id="chatPanel" layoutY="10.0" source="chat.fxml" />
         </children>
      </AnchorPane>
      <AnchorPane fx:id="panelAnchorPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="800.0" visible="false">
         <children>
            <ImageView fitHeight="444.0" fitWidth="806.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/Epoch%202%20Images/panelCloseUp.png" />
               </image>
            </ImageView>
            <Rectangle fx:id="rectElectricalPanel" arcHeight="5.0" arcWidth="5.0" fill="#d07a71" height="189.0" layoutX="333.0" layoutY="95.0" onMouseClicked="#onClickPanel" onMouseEntered="#onHover" onMouseExited="#onExit" opacity="0.0" stroke="BLACK" strokeType="INSIDE" width="142.0" />
         </children>
      </AnchorPane>
      <AnchorPane fx:id="panelOpenedAnchorPane" prefHeight="400.0" prefWidth="800.0" visible="false">
         <children>
            <ImageView fitHeight="443.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/Epoch%202%20Images/brokenPanelCloseup.png" />
               </image></ImageView>
            <Label fx:id="lblHint" alignment="CENTER" layoutX="265.0" layoutY="361.0" styleClass="interactable-text" text="It seems the wires have been tampered with." textAlignment="CENTER" wrapText="true" />
         </children>
      </AnchorPane>
      <Button fx:id="backButton" layoutX="703.0" layoutY="32.0" maxHeight="33.0" maxWidth="68.0" mnemonicParsing="false" onMouseClicked="#backButtonClick" styleClass="back-button" text="Go Back" />
   </children>
</Pane>
